<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- マイク捕捉 / UDP 通信 / Bonjour (NSD) discovery 用 permission。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 12+ の NSD で multicast 解決に必要。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Foreground Service (バックグラウンド継続) で必要。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ の通知表示権限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:label="AudioRouter"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioRouter"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="AudioRouter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- バックグラウンドでもマイク捕捉/UDP 送受信を続ける。
             type="microphone" は Android 14+ の必須属性で、これが無いと
             ホーム画面に戻った瞬間 AudioRecord が止まる。-->
        <service
            android:name=".AudioBridgeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
